# LibRPA G0W0 on a k-PATH, for a conventional band figure.
#
# The dense-grid run (si_case/librpa.in) is NOT touched: its band tables are
# what LibBSE consumes.  This run only produces GW_band_spin_1.dat on a real
# path, so the band figure has an honest abscissa.
#
# Prerequisite:  ABACUS nscf on the path KPT writes OUT.librpa_band/ with
#   band_kpath_info, band_KS_eigenvalue_k_*.txt, band_KS_eigenvector_k_*.txt,
#   band_vxc_k_*.txt  (preprocess_abacus_for_librpa_band.py).
# The RI/screening data are reused from the dense-grid OUT.librpa by symlink.
task = g0w0_band
input_dir = OUT.librpa_band
input_preset = abacus
fn_vxc_scf = ../OUT.scf/vxc_out.dat
output_dir = librpa_band.d

prefix_lri_coeff         = v1_Cs_data_
prefix_lri_coeff_shrink  = v1_Cs_shrinked_data_
prefix_shrink_sinvS      = v1_shrink_sinvS_
prefix_coul_cut          = v1_coulomb_cut_iq_
prefix_coul_full         = v1_coulomb_full_iq_

i_state_low = 0
i_state_high = 8
nfreq = 16
tfgrids_type = minimax
parallel_routing = libri

option_dielect_func = 3
replace_w_head = t
use_scalapack_gw_wc = t
vq_threshold = 0
sqrt_coulomb_threshold = 0
use_shrink_abfs = t
use_shrink_chi = f

output_energy_qp = t
output_wc_rf = t
ifreq_output_wc_end = 1
