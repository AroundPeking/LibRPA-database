INPUT_PARAMETERS

# Ground state + complete OUT.librpa data set on the SPARSE grid (k7x7x7).
#
# reader-v1 is ON. It is the only mode that writes `velocity_matrix` and the
# basis files, both mandatory for LibBSE. Its file names carry a `v1_` prefix
# that LibBSE's FileReaderOptions does not look for, so run_scf.slurm builds
# symlinks back to the legacy names LibBSE resolves.
suffix                  scf
pseudo_dir              ./
orbital_dir             ./
calculation             scf
basis_type              lcao
gamma_only              0
nbands                  44
symmetry                -1
nspin                   1
dft_functional          pbe

rpa                     1
rpa_out_vel             1
rpa_outdir              ./OUT.librpa/
out_librpa_reader_version 1
# LibBSE reads basis_aux (794, LARGE) and coulomb_unshrinked_cut together, so the
# cut Coulomb must be exported in the SAME large basis.  In reader-v1 mode the
# v1_coulomb_cut_iq_* files are written from the RPA-level cut Coulomb, which is
# already shrunk to 334; that mismatch aborts LibBSE with
# "Coulomb v1 Naux=334 does not match basis_aux.nb_total=794".
# out_unshrinked_v is the switch that additionally exports the large-basis cut
# Coulomb under the legacy name coulomb_unshrinked_cut_*, which is what
# FileReaderOptions.prefix_coul_cut resolves.
out_unshrinked_v        1

out_chg                 1
out_mat_xc              1
ecutwfc                 120
scf_thr                 1e-6
scf_nmax                100
smearing_method         gaussian
smearing_sigma          0.002
mixing_type             pulay
mixing_beta             0.4
mixing_gg0              0

exx_singularity_correction massidda
exx_real_number         1
exx_ccp_rmesh_times     2
rpa_ccp_rmesh_times     5
exx_pca_threshold       10
shrink_abfs_pca_thr     1e-6
shrink_lu_inv_thr       1e-6
