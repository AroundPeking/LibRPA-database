# GW case built from si64_symoff (ABACUS symmetry=-1 => correct full Ewald Coulomb).
# Baseline: OML templates/abacus-librpa-gw/template/librpa.in
# Deviations: input_preset=abacus (ABACUS text velocity_matrix, no PyATB on this route);
#             fn_*/prefix_* restored to the names ABACUS actually writes;
#             use_kpara_scf_eigvec=f (IBZ-only head/wing reconstruction).
task = g0w0
input_preset = abacus
tfgrids_type = minimax
nfreq = 16
n_params_anacon = -1
minimax_regulation = 1e-12
option_qpe_solver = 0
use_qpe_adaptive_damp = t
option_dielect_func = 53
replace_w_head = t

prefix_coul_full = v1_coulomb_full_iq_
prefix_coul_cut = v1_coulomb_cut_iq_
prefix_eigvecs_scf = KS_eigenvector
prefix_lri_coeff = v1_Cs_data_
prefix_velocity = velocity_matrix

fn_stru = stru_out.txt
fn_bz_sampling = bz_sampling_out
fn_basis_wfc = basis_wfc_out
fn_basis_aux = basis_aux_out
fn_eigocc_scf = band_out.txt
fn_vxc_scf = vxc_out

version_coul_reader = 1
version_lri_reader = 1
use_scalapack_gw_wc = t
use_cholesky_gw_wc = f
use_elpa_sqrt_coulomb = t
parallel_routing = libri
vq_threshold = 0
sqrt_coulomb_threshold = 0
use_shrink_abfs = f
use_symmetry_exx = t
use_symmetry_gw = t
use_fullcoul_exx = t
use_kpara_scf_eigvec = f
libri_chi0_collect_max_bytes = 2147483648
output_gw_sigc_mat_rf = f

libri_chi0_threshold_C = 1e-4
libri_chi0_threshold_G = 1e-5
libri_exx_threshold_V = 1e-2
libri_exx_threshold_C = 1e-4
libri_exx_threshold_D = 1e-4
libri_g0w0_threshold_C = 1e-5
libri_g0w0_threshold_G = 1e-5
libri_g0w0_threshold_Wc = 1e-6
fn_band_kpath_info = band_kpath_info
use_2d_dielectric = f
