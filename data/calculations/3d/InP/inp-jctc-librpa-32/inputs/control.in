# Basic setup
# Basic setup
xc               pbe
relativistic     atomic_zora scalar 
occupation_type  gaussian 0.0001
basis_threshold  1.e-5

# Periodic boundary conditions settings
k_grid  8  8  8

##################
# Band Structure #
##################
# K-paths taken from Setyawan and Curtarolo, 2010
output band  0.00000 0.00000 0.00000  0.50000 0.00000 0.50000   21 G X
output band  0.50000 0.00000 0.50000  0.50000 0.25000 0.75000   21 X W
output band  0.50000 0.25000 0.75000  0.37500 0.37500 0.75000   21 W K
output band  0.37500 0.37500 0.75000  0.00000 0.00000 0.00000   21 K G
output band  0.00000 0.00000 0.00000  0.50000 0.50000 0.50000   21 G L
output band  0.50000 0.50000 0.50000  0.62500 0.25000 0.62500   21 L U
output band  0.62500 0.25000 0.62500  0.50000 0.25000 0.75000   21 U W
output band  0.50000 0.25000 0.75000  0.50000 0.50000 0.50000   21 W L
output band  0.50000 0.50000 0.50000  0.37500 0.37500 0.75000   21 L K
output band  0.62500 0.25000 0.62500  0.50000 0.00000 0.50000   21 U X

# GW setting
qpe_calc         gw_expt
freq_grid_type   mod-GL
frequency_points 6
anacon_type      pade

output librpa binary develop fold_C

# Basis set
################################################################################
#
#  FHI-aims code project
#  Volker Blum, 2018
#
#  Suggested "intermediate" defaults for In atom (to be pasted into control.in file)
#
#  2020/09/15 These "intermediate" settings are identical to past "tight" defaults
#             and differ only in the "g" function that is now included in "tight".
#
################################################################################
  species        In
#     global species definitions
    nucleus             49
    mass                114.818
#
    l_hartree           6
#
    cut_pot             4.0  2.0  1.0
    basis_dep_cutoff    1e-4
#
    radial_base         62 7.0
    radial_multiplier   2
    angular_grids specified
      division   0.1831  110
      division   0.9161  194
      division   1.0115  302
      division   1.1156  434
#      division   1.1524  590
#      division   1.2296  770
#      division   7.0005  974
#      outer_grid  974
      outer_grid  434
################################################################################
#
#  Definition of "minimal" basis
#
################################################################################
#     valence basis states
    valence      5  s   2.
    valence      5  p   1.
    valence      4  d  10.
#     ion occupancy
    ion_occ     5  s   1.
    ion_occ     5  p   0.
    ion_occ     4  d  10.
################################################################################
#
#  Suggested additional basis functions. For production calculations, 
#  uncomment them one after another (the most important basis functions are
#  listed first).
#
#  Constructed for dimers: 2.15 A, 2.50 A, 3.00 A, 3.75 A, 4.75 A
#
################################################################################
#  "First tier" - max. impr. -128.95  meV, min. impr. -24.61 meV
     hydro 3 p 2.1
     hydro 4 f 7.6
     hydro 3 d 3.3
     hydro 3 s 2.9
#  "Second tier" - max. impr. -11.49 meV, min. impr. -0.63 meV
#     hydro 5 g 10
#     hydro 5 p 5.2
#     hydro 4 f 20.8
#     hydro 6 h 13.6
#     hydro 5 f 7.8
#     hydro 4 d 4.3
#     hydro 4 s 3.7   
#  "Third tier" - max. impr. -0.88 meV, min. impr. -0.10 meV
#     hydro 2 p 1.4
#     hydro 5 s 6
#     hydro 5 g 9.2
#     hydro 3 d 2.5
#     hydro 6 h 12.4
#     hydro 5 d 8.2
#     hydro 4 f 40.8
#  Further functions that fell out of the optimization: -0.08 meV and below
#     hydro 6 p 0.45
#     hydro 4 f 0.1

# for GW calculations
for_aux hydro 4 f 0.0
################################################################################
#
#  FHI-aims code project
#  Volker Blum, Maria Dragoumi, Sebastian Kokott 2020
#
#  Suggested "intermediate" defaults for P atom (to be pasted into control.in file)
#
################################################################################
  species        P
#     global species definitions
    nucleus             15
    mass                30.973762
#
    l_hartree           6
#
    cut_pot             4.0          2.0  1.0
    basis_dep_cutoff    1e-4
#
    radial_base         43 7.0
    radial_multiplier   2
    angular_grids       specified
      division   0.2995   50
      division   0.5998  110
      division   0.9240  194
      division   1.0921  302
      division   1.2863  434
#      division   1.3165  590
#      division   1.4113  770
#      division   1.5128  974
#      division   2.4980 1202
      outer_grid  434
################################################################################
#
#  Definition of "minimal" basis
#
################################################################################
#     valence basis states
    valence      3  s   2.
    valence      3  p   3.
#     ion occupancy
    ion_occ      3  s   1.
    ion_occ      3  p   2.
################################################################################
#
#  Suggested additional basis functions. For production calculations, 
#  uncomment them one after another (the most important basis functions are
#  listed first).
#
#  Constructed for dimers: 1.625 A, 1.875 A, 2.5 A, 3.25 A, 4.0 A
#
################################################################################
#  "First tier" - improvements: -726.20 meV to -35.91 meV
     ionic 3 d auto
     ionic 3 p auto
     hydro 4 f 6.2
  for_aux   hydro 5 g 8.6
     ionic 3 s auto
#  "Second tier" - improvements: -16.02 meV to -1.71 meV
#     hydro 4 d 6.2
#     hydro 4 p 9.2
#     hydro 5 f 9.8
#     hydro 1 s 0.7
#     hydro 5 g 13.2
#  "Third tier" - improvements: -1.82 meV to -0.20 meV
#     hydro 3 p 2.5
#     hydro 4 d 6.4
#     hydro 5 f 11.2
#     hydro 2 s 1.5
#  "Fourth tier" - improvements: -0.91 meV to -0.17 meV
#     hydro 3 d 16.8
#     hydro 5 g 18
#     hydro 4 p 4.5
#     hydro 3 s 2.1
#  Further basis functions that fell out of the optimization - < -0.09 meV
#     hydro 4 p 10.4
#     hydro 4 d 17.6
#     hydro 4 s 11.2
################################################################################
#
# For methods that use the localized form of the "resolution of identity" for
# the two-electron Coulomb operator (RI_method LVL), particularly Hartree-Fock and
# hybrid density functional calculations, the highest accuracy can be obtained by
# uncommenting the line beginning with "for_aux"  below, thus adding an extra g radial
# function to the construction of the product basis set for the expansion.
# See Ref. New J. Phys. 17, 093020 (2015) for more information, particularly Figs. 1 and 6.
#
################################################################################
#
# for_aux hydro 5 g 6.0

# for GW calculations
for_aux hydro 4 f 0.0
