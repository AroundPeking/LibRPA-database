xc               pbe
relativistic     atomic_zora scalar
spin             collinear
occupation_type  gaussian 0.0001
basis_threshold  0.e-5
qpe_calc         gw_expt 
periodic_gw_use_average_inverse_dm_gamma .true.

frequency_points 32
n_anacon_par 16
anacon_type 1

k_grid 8 8 8 
#state_upper_limit 100000

#default_prodbas_acc 0.0001
#print_input_librpa .true.
#symmetry_reduced_k_grid .false.  
#output librpa binary develop fold_C

#periodic_gw_full_matrix .true
#output self_energy_matrix 512 16 .true.
#periodic_gw_self_energy_restart write
#periodic_gw_optimize_kgrid_symmetry none
restart_periodic_gw restart_pgw binary

output gw_regular_kgrid
output k_eigenvalue 100000
calculate_all_eigenstates
#output self_energy

output band  0.50000 0.50000 0.50000  0.00000 0.00000 0.00000   21 L G
output band  0.00000 0.00000 0.00000  0.50000 0.00000 0.50000   21 G X
output band  0.50000 0.00000 0.50000  0.50000 0.25000 0.75000   21 X W
output band  0.50000 0.25000 0.75000  0.50000 0.50000 0.50000   21 W L
output band  0.50000 0.50000 0.50000  0.37500 0.37500 0.75000   21 L K
output band  0.37500 0.37500 0.75000  0.00000 0.00000 0.00000   21 K G

################################################################################
#
#  FHI-aims code project
#  Volker Blum, Maria Dragoumi, Sebastian Kokott 2020
#
#  Suggested "intermediate" defaults for Ni atom (to be pasted into control.in file)
#
################################################################################
  species        Ni
#     global species definitions
    nucleus             28
    mass                58.6934
#
    l_hartree           6
#
    cut_pot             4.0          2.0  1.0
    basis_dep_cutoff    1e-4
#
    radial_base         52 7.0
    radial_multiplier   2
    angular_grids       specified
      division   0.2935   50
      division   0.6132  110
      division   0.9287  194
      division   1.1299  302
      division   1.3700  434
#      division   1.5675  590
#      division   1.7612  770
#      division   1.9438  974
#      division   2.5441 1202
      outer_grid  434
################################################################################
#
#  Definition of "minimal" basis
#
################################################################################
#     valence basis states
    valence      4  s   2.
    valence      3  p   6.
    valence      3  d   8.
#     ion occupancy
    ion_occ      4  s   1.
    ion_occ      3  p   6.
    ion_occ      3  d   7.
################################################################################
#
#  Suggested additional basis functions. For production calculations, 
#  uncomment them one after another (the most important basis functions are
#  listed first).
#
#  Constructed for dimers: 1.65 A, 2.00 A, 2.50 A, 3.00 A, 4.00 A
#
################################################################################
#  "First tier" - improvements: -123.08 meV to -11.61 meV 
     hydro 3 p 6
     hydro 4 f 9
  for_aux   hydro 5 g 12.4
     hydro 3 d 5.2
     ionic 4 s auto
#  "Second tier" - improvements: -6.71 meV to -1.07 meV
     ionic 4 p auto
#     hydro 4 d 6
#     hydro 6 h 18
#     hydro 4 f 9.4
#     hydro 4 f 16.4
#     hydro 1 s 0.75
#  "Third tier" - improvements: -0.57 meV to -0.07 meV
#     hydro 4 p 18.4
#     hydro 4 d 8
#     hydro 5 g 13.2
#     hydro 5 f 8.4
#     hydro 6 h 16.8
#     hydro 4 s 4.4
#  Further functions: improvements -0.07 meV and below
#     hydro 5 f 16.8
#     hydro 4 p 10


# for GW calculations
for_aux hydro 4 f 0.0
################################################################################
#
#  FHI-aims code project
#  Volker Blum, 2017
#
#  Suggested "intermediate" defaults for O atom (to be pasted into control.in file)
#
################################################################################
  species        O
#     global species definitions
    nucleus             8
    mass                15.9994
#
    l_hartree           6
#
    cut_pot             4.0  2.0  1.0
    basis_dep_cutoff    1e-4
#
    radial_base         36 7.0
    radial_multiplier   2
     angular_grids specified
      division   0.1817   50
      division   0.3417  110
      division   0.4949  194
      division   0.6251  302
      division   0.8014  434
#      division   0.8507  590
#      division   0.8762  770
#      division   0.9023  974
#      division   1.2339 1202
#      outer_grid 974
      outer_grid  434
################################################################################
#
#  Definition of "minimal" basis
#
################################################################################
#     valence basis states
    valence      2  s   2.
    valence      2  p   4.
#     ion occupancy
    ion_occ      2  s   1.
    ion_occ      2  p   3.
################################################################################
#
#  Suggested additional basis functions. For production calculations, 
#  uncomment them one after another (the most important basis functions are
#  listed first).
#
#  Constructed for dimers: 1.0 A, 1.208 A, 1.5 A, 2.0 A, 3.0 A
#
################################################################################
#  "First tier" - improvements: -699.05 meV to -159.38 meV
     hydro 2 p 1.8
     hydro 3 d 7.6
     hydro 3 s 6.4
#  "Second tier" - improvements: -49.91 meV to -5.39 meV
     hydro 4 f 11.6
#     hydro 3 p 6.2
#     hydro 3 d 5.6
  for_aux    hydro 5 g 17.6
#     hydro 1 s 0.75
#  "Third tier" - improvements: -2.83 meV to -0.50 meV
#     ionic 2 p auto
#     hydro 4 f 10.8
#     hydro 4 d 4.7
#     hydro 2 s 6.8
#  "Fourth tier" - improvements: -0.40 meV to -0.12 meV
#     hydro 3 p 5
#     hydro 3 s 3.3
#     hydro 5 g 15.6
#     hydro 4 f 17.6
#     hydro 4 d 14
# Further basis functions - -0.08 meV and below
#     hydro 3 s 2.1
#     hydro 4 d 11.6
#     hydro 3 p 16
#     hydro 2 s 17.2

# for GW calculations
for_aux hydro 4 f 0.0
