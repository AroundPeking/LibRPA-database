  -----------------------------------------------------------------------
  
  # Basic setup
  # Basic setup
  xc               pbe
  relativistic     atomic_zora scalar
  occupation_type  gaussian 0.0001
  basis_threshold  1.e-5
  
  # Periodic boundary conditions settings
  k_grid  8  8  8
  
  ##################
  # Band Structure #
  ##################
  # K-paths taken from Setyawan and Curtarolo, 2010
  output band  0.00000 0.00000 0.00000  0.50000 0.00000 0.50000   21 G X
  output band  0.50000 0.00000 0.50000  0.50000 0.25000 0.75000   21 X W
  output band  0.50000 0.25000 0.75000  0.37500 0.37500 0.75000   21 W K
  output band  0.37500 0.37500 0.75000  0.00000 0.00000 0.00000   21 K G
  output band  0.00000 0.00000 0.00000  0.50000 0.50000 0.50000   21 G L
  output band  0.50000 0.50000 0.50000  0.62500 0.25000 0.62500   21 L U
  output band  0.62500 0.25000 0.62500  0.50000 0.25000 0.75000   21 U W
  output band  0.50000 0.25000 0.75000  0.50000 0.50000 0.50000   21 W L
  output band  0.50000 0.50000 0.50000  0.37500 0.37500 0.75000   21 L K
  output band  0.62500 0.25000 0.62500  0.50000 0.00000 0.50000   21 U X
  
  # GW setting
  qpe_calc         gw_expt
  freq_grid_type   mod-GL
  frequency_points 6
  anacon_type      pade
  
  output librpa binary develop fold_C
  
  # Basis set
  ################################################################################
  #
  #  FHI-aims code project
  #  Volker Blum, 2017
  #
  #  Suggested "intermediate" defaults for N atom (to be pasted into control.in file)
  #
  ################################################################################
    species        N
  #     global species definitions
      nucleus             7
      mass                14.0067
  #
      l_hartree           6
  #
      cut_pot             4.0  2.0  1.0
      basis_dep_cutoff    1e-4
  #
      radial_base         35 7.0
      radial_multiplier   2
      angular_grids       specified
        division   0.1841   50
        division   0.3514  110
        division   0.5126  194
        division   0.6292  302
        division   0.6939  434
  #      division   0.7396  590
  #      division   0.7632  770
  #      division   0.8122  974
  #      division   1.1604 1202
  #      outer_grid  974
        outer_grid  434
  ################################################################################
  #
  #  Definition of "minimal" basis
  #
  ################################################################################
  #     valence basis states
      valence      2  s   2.
      valence      2  p   3.
  #     ion occupancy
      ion_occ      2  s   1.
      ion_occ      2  p   2.
  ################################################################################
  #
  #  Suggested additional basis functions. For production calculations,
  #  uncomment them one after another (the most important basis functions are
  #  listed first).
  #
  #  Constructed for dimers: 1.0 A, 1.1 A, 1.5 A, 2.0 A, 3.0 A
  #
  ################################################################################
  #  "First tier" - improvements: -1193.42 meV to -220.60 meV
       hydro 2 p 1.8
       hydro 3 d 6.8
       hydro 3 s 5.8
  #  "Second tier" - improvements: -80.21 meV to -6.86 meV
       hydro 4 f 10.8
  #     hydro 3 p 5.8
  #     hydro 1 s 0.8
    for_aux    hydro 5 g 16
  #     hydro 3 d 4.9
  #  "Third tier" - improvements: -4.29 meV to -0.53 meV
  #     hydro 3 s 16
  #     ionic 2 p auto
  #     hydro 3 d 6.6
  #     hydro 4 f 11.6
  #  "Fourth tier" - improvements: -0.75 meV to -0.25 meV
  #     hydro 2 p 4.5
  #     hydro 2 s 2.4
  #     hydro 5 g 14.4
  #     hydro 4 d 14.4
  #     hydro 4 f 16.8
  # Further basis functions - -0.21 meV and below
  #     hydro 3 p 14.8
  #     hydro 3 s 4.4
  #     hydro 3 d 19.6
  #     hydro 5 g 12.8
  
  # for GW calculations
  for_aux hydro 4 f 0.0
  ################################################################################
  #
  #  FHI-aims code project
  #  Volker Blum, 2018
  #
  #  Suggested "intermediate" defaults for Ga atom (to be pasted into control.in file)
  #
  #  2020/09/15 These "intermediate" settings are identical to past "tight" defaults
  #             and differ only in the "g" function that is now included in "tight".
  #
  ################################################################################
    species        Ga
  #     global species definitions
      nucleus             31
      mass                69.723
  #
      l_hartree           6
  #
      cut_pot             4.0          2.0  1.0
      basis_dep_cutoff    1e-4
  #
      radial_base         54 7.0
      radial_multiplier   2
      angular_grids       specified
        division   0.3498   50
        division   0.6591  110
        division   0.9587  194
        division   1.2234  302
        division   1.4453  434
  #      division   1.5860  590
  #      division   1.8791  770
  #      division   1.9525  974
  #      division   2.3801 1202
  #      outer_grid  1202
        outer_grid  434
  ################################################################################
  #
  #  Definition of "minimal" basis
  #
  ################################################################################
  #     valence basis states
      valence      4  s   2.
      valence      4  p   1.
      valence      3  d  10.
  #     ion occupancy
      ion_occ      4  s   1.
      ion_occ      3  p   6.
      ion_occ      3  d  10.
  ################################################################################
  #
  #  Suggested additional basis functions. For production calculations,
  #  uncomment them one after another (the most important basis functions are
  #  listed first).
  #
  #  Constructed for dimers: 1.85 A, 2.10 A, 2.45 A, 3.00 A, 4.00 A
  #
  ################################################################################
  #  "First tier" - improvements: -222.33 meV to -26.19 meV
       hydro 2 p 1.2
       hydro 3 d 3.8
       hydro 4 f 6.8
       ionic 4 s auto
  #  "Second tier" - improvements: -11.68 meV to -1.61 meV
  #     hydro 5 g 10
  #     hydro 4 p 3.6
  #     hydro 4 f 13.2
  #     hydro 6 h 14.4
  #     hydro 4 d 5.2
  #     hydro 1 s 0.45
  #  "Third tier" - improvements: -0.64 meV to -0.15 meV
  #     hydro 3 p 3.4
  #     hydro 3 s 2.2
  #     hydro 5 g 14
  #     hydro 4 f 6.2
  #     hydro 5 d 7.2
  #  "Fourth tier"  -improvements: -0.12 meV and below
  #     hydro 3 s 3.8
  #     hydro 5 f 27.2
  #     hydro 6 h 16
  #     hydro 5 g 9.2
  #     hydro 4 d 8.6
  #     hydro 2 p 3.6
  
  
  # for GW calculations
  for_aux hydro 4 f 0.0
  
