# Basic setup
# Basic setup
xc               pbe
relativistic     atomic_zora scalar 
occupation_type  gaussian 0.0001
basis_threshold  1.e-5

# Periodic boundary conditions settings
k_grid  8  8  8

##################
# Band Structure #
##################
# K-paths taken from Setyawan and Curtarolo, 2010
output band  0.00000 0.00000 0.00000  0.50000 0.00000 0.50000   21 G X
output band  0.50000 0.00000 0.50000  0.50000 0.25000 0.75000   21 X W
output band  0.50000 0.25000 0.75000  0.37500 0.37500 0.75000   21 W K
output band  0.37500 0.37500 0.75000  0.00000 0.00000 0.00000   21 K G
output band  0.00000 0.00000 0.00000  0.50000 0.50000 0.50000   21 G L
output band  0.50000 0.50000 0.50000  0.62500 0.25000 0.62500   21 L U
output band  0.62500 0.25000 0.62500  0.50000 0.25000 0.75000   21 U W
output band  0.50000 0.25000 0.75000  0.50000 0.50000 0.50000   21 W L
output band  0.50000 0.50000 0.50000  0.37500 0.37500 0.75000   21 L K
output band  0.62500 0.25000 0.62500  0.50000 0.00000 0.50000   21 U X

# GW setting
qpe_calc         gw_expt
freq_grid_type   mod-GL
frequency_points 6
anacon_type      pade

output librpa binary develop fold_C

# Basis set
################################################################################
#
#  FHI-aims code project
#  Volker Blum, 2018
#
#  Suggested "intermediate" defaults for S atom (to be pasted into control.in file)
#
################################################################################
  species        S
#     global species definitions
    nucleus             16
    mass                32.065
#
    l_hartree           6
#
    cut_pot             4.0          2.0  1.0
    basis_dep_cutoff    1e-4
#
    radial_base         44 7.0
    radial_multiplier   2
    angular_grids       specified
      division   0.4665  110
      division   0.5810  194
      division   0.7139  302
      division   0.8274  434
#      division   0.9105  590
#      division   1.0975  770
#      division   1.2028  974
#      outer_grid  974
      outer_grid  434
################################################################################
#
#  Definition of "minimal" basis
#
################################################################################
#     valence basis states
    valence      3  s   2.
    valence      3  p   4.
#     ion occupancy
    ion_occ      3  s   1.
    ion_occ      3  p   3.
################################################################################
#
#  Suggested additional basis functions. For production calculations, 
#  uncomment them one after another (the most important basis functions are
#  listed first).
#
#  Constructed for dimers: 1.6 A, 1.9 A, 2.5 A, 3.25 A, 4.0 A
#
################################################################################
#  "First tier" - improvements: -652.81 meV to -45.53 meV
     ionic 3 d auto
     hydro 2 p 1.8
     hydro 4 f 7
     ionic 3 s auto
#  "Second tier" - improvements: -30.20 meV to -1.74 meV
#     hydro 4 d 6.2
for_aux     hydro 5 g 10.8
#     hydro 4 p 4.9
#     hydro 5 f 10
#     hydro 1 s 0.8
#  "Third tier" - improvements: -1.04 meV to -0.20 meV
#     hydro 3 d 3.9
#     hydro 3 d 2.7
#     hydro 5 g 12
#     hydro 4 p 10.4
#     hydro 5 f 12.4
#     hydro 2 s 1.9
#  "Fourth tier" - improvements: -0.35 meV to -0.06 meV
#     hydro 4 d 10.4
#     hydro 4 p 7.2
#     hydro 4 d 10
#     hydro 5 g 19.2
#     hydro 4 s 12


# for GW calculations
for_aux hydro 4 f 0.0
################################################################################
#
#  FHI-aims code project
#  Volker Blum, Maria Dragoumi, Sebastian Kokott 2020
#
#  Suggested "intermediate" defaults for Cd atom (to be pasted into control.in file)
#
################################################################################
  species        Cd
#     global species definitions
    nucleus             48
    mass                112.411
#
    l_hartree           6
#
    cut_pot             4.0  2.0  1.0
    basis_dep_cutoff    1e-4
#
    radial_base         62 7.0
    radial_multiplier   2
    angular_grids specified
      division   0.4113   50
      division   0.7872  110
      division   1.1524  194
      division   1.3993  302
      division   1.8186  434
#      division   2.1568  590
#      division   2.3152  770
#      division   2.3574  974
#      division   2.9077 1202
#      outer_grid  974
      outer_grid  434
################################################################################
#
#  Definition of "minimal" basis
#
################################################################################
#     valence basis states
    valence      5  s   2.
    valence      4  p   6.
    valence      4  d  10.
#     ion occupancy
    ion_occ     5  s   1.
    ion_occ     4  p   6.
    ion_occ     4  d   9.
################################################################################
#
#  Suggested additional basis functions. For production calculations, 
#  uncomment them one after another (the most important basis functions are
#  listed first).
#
#  Constructed for dimers: 2.15 A, 2.50 A, 3.10 A, 4.00 A, 5.00 A
#
################################################################################
#  "First tier" - max. impr. -224.92  meV, min. impr. -5.81 meV
     hydro 2 p 1.6
     hydro 4 f 7
     hydro 3 s 2.8
     hydro 3 p 5.2
  for_aux   hydro 5 g 10.0
     hydro 3 d 3.8
#  "Second tier" - max. impr. -2.57  meV, min. impr. -0.38 meV
#     hydro 4 f 17.6
#     hydro 6 h 13.6
#     hydro 3 p 7
#     hydro 5 s 17.6
#     hydro 3 d 3.4
#  "Third tier" - max. impr. -0.37 meV, min. impr. -0.09 meV
#     hydro 3 p 2.4
#     hydro 4 f 6.4
#     hydro 4 s 4
#     hydro 5 f 15.6
#     hydro 5 g 10.8
#     hydro 2 p 6.4
#     hydro 6 h 12.8
#     hydro 5 d 9.0
#  Further functions: -0.05 meV and below
#     hydro 5 d 5.8  

# for GW calculations
for_aux hydro 4 f 0.0
