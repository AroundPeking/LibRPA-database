      nucleus             48
      mass                112.411
  #
      l_hartree           6
  #
      cut_pot             4.0  2.0  1.0
      basis_dep_cutoff    1e-4
  #
      radial_base         62 7.0
      radial_multiplier   2
      angular_grids specified
        division   0.4113   50
        division   0.7872  110
        division   1.1524  194
        division   1.3993  302
        division   1.8186  434
  #      division   2.1568  590
  #      division   2.3152  770
  #      division   2.3574  974
  #      division   2.9077 1202
  #      outer_grid  974
        outer_grid  434
  ################################################################################
  #
  #  Definition of "minimal" basis
  #
  ################################################################################
  #     valence basis states
      valence      5  s   2.
      valence      4  p   6.
      valence      4  d  10.
  #     ion occupancy
      ion_occ     5  s   1.
      ion_occ     4  p   6.
      ion_occ     4  d   9.
  ################################################################################
  #
  #  Suggested additional basis functions. For production calculations,
  #  uncomment them one after another (the most important basis functions are
  #  listed first).
  #
