  #     hydro 4 f 6.4
  #     hydro 4 s 4
  #     hydro 5 f 15.6
  #     hydro 5 g 10.8
  #     hydro 2 p 6.4
  #     hydro 6 h 12.8
  #     hydro 5 d 9.0
  #  Further functions: -0.05 meV and below
  #     hydro 5 d 5.8
  
  # for GW calculations
  for_aux hydro 4 f 0.0
  
