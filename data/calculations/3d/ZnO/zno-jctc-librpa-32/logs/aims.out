  -----------------------------------------------------------------------
  
  # Basic setup
  # Basic setup
  xc               pbe
  relativistic     atomic_zora scalar
  occupation_type  gaussian 0.0001
  basis_threshold  1.e-5
  
  # Periodic boundary conditions settings
  k_grid  8  8  8
  
  ##################
  # Band Structure #
  ##################
  # K-paths taken from Setyawan and Curtarolo, 2010
  output band  0.00000 0.00000 0.00000  0.50000 0.00000 0.50000   21 G X
  output band  0.50000 0.00000 0.50000  0.50000 0.25000 0.75000   21 X W
  output band  0.50000 0.25000 0.75000  0.37500 0.37500 0.75000   21 W K
  output band  0.37500 0.37500 0.75000  0.00000 0.00000 0.00000   21 K G
  output band  0.00000 0.00000 0.00000  0.50000 0.50000 0.50000   21 G L
  output band  0.50000 0.50000 0.50000  0.62500 0.25000 0.62500   21 L U
  output band  0.62500 0.25000 0.62500  0.50000 0.25000 0.75000   21 U W
  output band  0.50000 0.25000 0.75000  0.50000 0.50000 0.50000   21 W L
  output band  0.50000 0.50000 0.50000  0.37500 0.37500 0.75000   21 L K
  output band  0.62500 0.25000 0.62500  0.50000 0.00000 0.50000   21 U X
  
  # GW setting
  qpe_calc         gw_expt
  freq_grid_type   mod-GL
  frequency_points 6
  anacon_type      pade
  
  output librpa binary develop fold_C
  
  # Basis set
  ################################################################################
  #
  #  FHI-aims code project
  #  Volker Blum, Maria Dragoumi, Sebastian Kokott 2020
  #
  #  Suggested "intermediate" defaults for Zn atom (to be pasted into control.in file)
  #
  ################################################################################
    species        Zn
  #     global species definitions
      nucleus             30
      mass                65.409
  #
      l_hartree           6
  #
      cut_pot             4.0          2.0  1.0
      basis_dep_cutoff    1e-4
  #
      radial_base         53 7.0
      radial_multiplier   2
      angular_grids       specified
        division   0.4348   50
        division   0.7981  110
        division   1.1328  194
        division   1.3947  302
        division   1.6856  434
  #      division   1.8921  590
  #      division   2.0877  770
  #      division   2.1730  974
  #      division   2.5659 1202
        outer_grid  434
  ################################################################################
  #
  #  Definition of "minimal" basis
  #
  ################################################################################
  #     valence basis states
      valence      4  s   2.
      valence      3  p   6.
      valence      3  d  10.
  #     ion occupancy
      ion_occ      4  s   1.
      ion_occ      3  p   6.
      ion_occ      3  d   9.
  ################################################################################
  #
  #  Suggested additional basis functions. For production calculations,
  #  uncomment them one after another (the most important basis functions are
  #  listed first).
  #
  #  Constructed for dimers: 2.00 A, 2.30 A, 2.85 A, 3.50 A, 4.25 A
  #
  ################################################################################
  #  "First tier" - improvements: -270.82 meV to -12.81 meV
       hydro 2 p 1.7
       hydro 3 s 2.9
       hydro 4 p 5.4
       hydro 4 f 7.8
       hydro 3 d 4.5
  #  "Second tier" - improvements: -3.35 meV to -0.82 meV
    for_aux     hydro 5 g 10.8
  #     hydro 2 p 2.4
  #     hydro 3 s 6.2
  #     hydro 3 d 3
  #  "Third tier" - improvements: -0.61 meV to -0.12 meV
  #     hydro 6 h 15.2
  #     ionic 4 p auto
  #     hydro 5 s 12.8
  #     hydro 4 f 5.4
  #     hydro 4 d 7
  #  Further functions - improvements: -0.16 meV and below
  #     hydro 4 f 20
  #     hydro 3 p 2.2
  #     hydro 5 f 6.4
  #     hydro 5 g 8
  
  # for GW calculations
  for_aux hydro 4 f 0.0
  ################################################################################
  #
  #  FHI-aims code project
  #  Volker Blum, 2017
  #
  #  Suggested "intermediate" defaults for O atom (to be pasted into control.in file)
  #
  ################################################################################
    species        O
  #     global species definitions
      nucleus             8
      mass                15.9994
  #
      l_hartree           6
  #
      cut_pot             4.0  2.0  1.0
      basis_dep_cutoff    1e-4
  #
      radial_base         36 7.0
      radial_multiplier   2
       angular_grids specified
        division   0.1817   50
        division   0.3417  110
        division   0.4949  194
        division   0.6251  302
        division   0.8014  434
  #      division   0.8507  590
  #      division   0.8762  770
  #      division   0.9023  974
  #      division   1.2339 1202
  #      outer_grid 974
        outer_grid  434
  ################################################################################
  #
  #  Definition of "minimal" basis
  #
  ################################################################################
  #     valence basis states
      valence      2  s   2.
      valence      2  p   4.
  #     ion occupancy
      ion_occ      2  s   1.
      ion_occ      2  p   3.
  ################################################################################
  #
  #  Suggested additional basis functions. For production calculations,
  #  uncomment them one after another (the most important basis functions are
  #  listed first).
  #
  #  Constructed for dimers: 1.0 A, 1.208 A, 1.5 A, 2.0 A, 3.0 A
  #
  ################################################################################
  #  "First tier" - improvements: -699.05 meV to -159.38 meV
       hydro 2 p 1.8
       hydro 3 d 7.6
       hydro 3 s 6.4
  #  "Second tier" - improvements: -49.91 meV to -5.39 meV
       hydro 4 f 11.6
  #     hydro 3 p 6.2
  #     hydro 3 d 5.6
    for_aux    hydro 5 g 17.6
  #     hydro 1 s 0.75
  #  "Third tier" - improvements: -2.83 meV to -0.50 meV
  #     ionic 2 p auto
  #     hydro 4 f 10.8
  #     hydro 4 d 4.7
  #     hydro 2 s 6.8
  #  "Fourth tier" - improvements: -0.40 meV to -0.12 meV
  #     hydro 3 p 5
  #     hydro 3 s 3.3
  #     hydro 5 g 15.6
  #     hydro 4 f 17.6
  #     hydro 4 d 14
  # Further basis functions - -0.08 meV and below
  #     hydro 3 s 2.1
  #     hydro 4 d 11.6
  #     hydro 3 p 16
  #     hydro 2 s 17.2
  
  # for GW calculations
  for_aux hydro 4 f 0.0
  
