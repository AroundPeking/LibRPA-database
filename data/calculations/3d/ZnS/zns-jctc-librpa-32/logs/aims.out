  -----------------------------------------------------------------------
  
  # Basic setup
  # Basic setup
  xc               pbe
  relativistic     atomic_zora scalar
  occupation_type  gaussian 0.0001
  basis_threshold  1.e-5
  
  # Periodic boundary conditions settings
  k_grid  8  8  8
  
  ##################
  # Band Structure #
  ##################
  # K-paths taken from Setyawan and Curtarolo, 2010
  output band  0.00000 0.00000 0.00000  0.50000 0.00000 0.50000   21 G X
  output band  0.50000 0.00000 0.50000  0.50000 0.25000 0.75000   21 X W
  output band  0.50000 0.25000 0.75000  0.37500 0.37500 0.75000   21 W K
  output band  0.37500 0.37500 0.75000  0.00000 0.00000 0.00000   21 K G
  output band  0.00000 0.00000 0.00000  0.50000 0.50000 0.50000   21 G L
  output band  0.50000 0.50000 0.50000  0.62500 0.25000 0.62500   21 L U
  output band  0.62500 0.25000 0.62500  0.50000 0.25000 0.75000   21 U W
  output band  0.50000 0.25000 0.75000  0.50000 0.50000 0.50000   21 W L
  output band  0.50000 0.50000 0.50000  0.37500 0.37500 0.75000   21 L K
  output band  0.62500 0.25000 0.62500  0.50000 0.00000 0.50000   21 U X
  
  # GW setting
  qpe_calc         gw_expt
  freq_grid_type   mod-GL
  frequency_points 6
  anacon_type      pade
  
  output librpa binary develop fold_C
  
  # Basis set
  ################################################################################
  #
  #  FHI-aims code project
  #  Volker Blum, 2018
  #
  #  Suggested "intermediate" defaults for S atom (to be pasted into control.in file)
  #
  ################################################################################
    species        S
  #     global species definitions
      nucleus             16
      mass                32.065
  #
      l_hartree           6
  #
      cut_pot             4.0          2.0  1.0
      basis_dep_cutoff    1e-4
  #
      radial_base         44 7.0
      radial_multiplier   2
      angular_grids       specified
        division   0.4665  110
        division   0.5810  194
        division   0.7139  302
        division   0.8274  434
  #      division   0.9105  590
  #      division   1.0975  770
  #      division   1.2028  974
  #      outer_grid  974
        outer_grid  434
  ################################################################################
  #
  #  Definition of "minimal" basis
  #
  ################################################################################
  #     valence basis states
      valence      3  s   2.
      valence      3  p   4.
  #     ion occupancy
      ion_occ      3  s   1.
      ion_occ      3  p   3.
  ################################################################################
  #
  #  Suggested additional basis functions. For production calculations,
  #  uncomment them one after another (the most important basis functions are
  #  listed first).
  #
  #  Constructed for dimers: 1.6 A, 1.9 A, 2.5 A, 3.25 A, 4.0 A
  #
  ################################################################################
  #  "First tier" - improvements: -652.81 meV to -45.53 meV
       ionic 3 d auto
       hydro 2 p 1.8
       hydro 4 f 7
       ionic 3 s auto
  #  "Second tier" - improvements: -30.20 meV to -1.74 meV
  #     hydro 4 d 6.2
  for_aux     hydro 5 g 10.8
  #     hydro 4 p 4.9
  #     hydro 5 f 10
  #     hydro 1 s 0.8
  #  "Third tier" - improvements: -1.04 meV to -0.20 meV
  #     hydro 3 d 3.9
  #     hydro 3 d 2.7
  #     hydro 5 g 12
  #     hydro 4 p 10.4
  #     hydro 5 f 12.4
  #     hydro 2 s 1.9
  #  "Fourth tier" - improvements: -0.35 meV to -0.06 meV
  #     hydro 4 d 10.4
  #     hydro 4 p 7.2
  #     hydro 4 d 10
  #     hydro 5 g 19.2
  #     hydro 4 s 12
  
  
  # for GW calculations
  for_aux hydro 4 f 0.0
  ################################################################################
  #
  #  FHI-aims code project
  #  Volker Blum, Maria Dragoumi, Sebastian Kokott 2020
  #
  #  Suggested "intermediate" defaults for Zn atom (to be pasted into control.in file)
  #
  ################################################################################
    species        Zn
  #     global species definitions
      nucleus             30
      mass                65.409
  #
      l_hartree           6
  #
      cut_pot             4.0          2.0  1.0
      basis_dep_cutoff    1e-4
  #
      radial_base         53 7.0
      radial_multiplier   2
      angular_grids       specified
        division   0.4348   50
        division   0.7981  110
        division   1.1328  194
        division   1.3947  302
        division   1.6856  434
  #      division   1.8921  590
  #      division   2.0877  770
  #      division   2.1730  974
  #      division   2.5659 1202
        outer_grid  434
  ################################################################################
  #
  #  Definition of "minimal" basis
  #
  ################################################################################
  #     valence basis states
      valence      4  s   2.
      valence      3  p   6.
      valence      3  d  10.
  #     ion occupancy
      ion_occ      4  s   1.
      ion_occ      3  p   6.
      ion_occ      3  d   9.
  ################################################################################
  #
  #  Suggested additional basis functions. For production calculations,
  #  uncomment them one after another (the most important basis functions are
  #  listed first).
  #
  #  Constructed for dimers: 2.00 A, 2.30 A, 2.85 A, 3.50 A, 4.25 A
  #
  ################################################################################
  #  "First tier" - improvements: -270.82 meV to -12.81 meV
       hydro 2 p 1.7
       hydro 3 s 2.9
       hydro 4 p 5.4
       hydro 4 f 7.8
       hydro 3 d 4.5
  #  "Second tier" - improvements: -3.35 meV to -0.82 meV
    for_aux     hydro 5 g 10.8
  #     hydro 2 p 2.4
  #     hydro 3 s 6.2
  #     hydro 3 d 3
  #  "Third tier" - improvements: -0.61 meV to -0.12 meV
  #     hydro 6 h 15.2
  #     ionic 4 p auto
  #     hydro 5 s 12.8
  #     hydro 4 f 5.4
  #     hydro 4 d 7
  #  Further functions - improvements: -0.16 meV and below
  #     hydro 4 f 20
  #     hydro 3 p 2.2
  #     hydro 5 f 6.4
  #     hydro 5 g 8
  
  # for GW calculations
  for_aux hydro 4 f 0.0
  
