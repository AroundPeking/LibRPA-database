# MoS2 monolayer G0W0 on the 14x14x1 full-BZ grid (196 k points).
#
# No option_velocity and no g0w0_fn_*: this runs the default pyatb velocity
# source, which reads the velocity_matrix ABACUS itself wrote during the SCF on
# 2026-11-23. That route does not differentiate H(R)/S(R)/r(R), so it has no
# |U^T S U - I| gate and needs no IBZ -> full-BZ eigenvector expansion.
#
# fn_vxc_scf is relative to input_dir: LibRPA builds the path by string
# concatenation (driver/tasks/g0w0.cpp: read_vxc(input_dir + fn_vxc_scf)), so an
# absolute path would be treated as a relative name.
task = g0w0
input_dir = /HPC/mos2_bse/_fullbz_archive/OUT.librpa_fullbz
input_preset = abacus
output_dir = librpa.d
output_level = info

version_coul_reader = 1
version_lri_reader = 1
prefix_coul_full = v1_coulomb_full_iq_
prefix_coul_cut = v1_coulomb_cut_iq_
prefix_lri_coeff = v1_Cs_data_
prefix_lri_coeff_shrink = v1_Cs_shrinked_data_
prefix_shrink_sinvS = v1_shrink_sinvS_
prefix_eigvecs_scf = KS_eigenvector
prefix_velocity = velocity_matrix
fn_stru = stru_out
fn_bz_sampling = bz_sampling_out
fn_basis_wfc = basis_wfc_out
fn_basis_aux = basis_aux_out
fn_basis_aux_shrink = basis_aux_shrink_out
fn_eigocc_scf = band_out
fn_vxc_scf = ../OUT.ABACUS_fullbz/vxc_out.dat

i_state_low = 9
i_state_high = 17
nfreq = 16
tfgrids_type = minimax
n_params_anacon = 12
parallel_routing = libri

option_dielect_func = 3
replace_w_head = t
use_2d_dielectric = t

# Strict-2D head/wing builds the dielectric and the external legs from the full
# 2D Ewald Coulomb: validate_strict_2d_gw_coulomb_choices requires both of these
# whenever use_2d_dielectric is on (src/core/dielecmodel.cpp:1276).
# The 3D Si reference case does not set them because it is not 2D.
use_fullcoul_eps = t
use_fullcoul_wc = t
use_scalapack_gw_wc = t
vq_threshold = 0
sqrt_coulomb_threshold = 0
use_shrink_abfs = t
use_shrink_chi = f

output_energy_qp = t
output_wc_rf = t
ifreq_output_wc_end = 1
output_wc_rf_atom_pair = f
