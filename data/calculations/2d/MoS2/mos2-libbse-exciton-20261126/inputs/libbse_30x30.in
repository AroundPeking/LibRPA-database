# MoS2 monolayer BSE with the coarse/fine split the manuscript uses:
# screening and RI on the 14x14x1 mesh, transition space on 30x30x1 (900 k).
#
# input_dir is the 14x14 producer whose bz_sampling_out defines the coarse mesh
# and whose stru_out/basis files the run reads; qp_data points at the 900-point
# QP table built from the 30x30 band G0W0, so bse_use_fine_kgrid = 1 selects it.
input_dir                  /HPC/mos2_clean_20261123/bse_30x30/OUT.librpa_mixed
input_format               librpa
qp_data                    /HPC/mos2_clean_20261123/bse_results_fine/energy_qp_fine_30x30
qp_format                  energy_qp
screened_format            librpa_wc
screened_dir               /HPC/mos2_clean_20261123/gw_run/librpa.d_pairs
output_dir                 libbse30.d

nocc                       4
nvirt                      4
bse_nstates                -1
bse_solver                 elpa
bse_spin_types             singlet
bse_tda                    tda
bse_ri_hartree             1
bse_use_fine_kgrid         1

abs_gauge                  velocity
wavefunction_gauge         first_k
spectrum_broadening_ev     0.10
spectrum_energy_step_ev    0.01
spectrum_energy_min_ev     0.0
spectrum_energy_max_ev     5.0
