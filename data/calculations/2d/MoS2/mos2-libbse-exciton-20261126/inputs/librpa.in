# MoS2 2D GW: strict-2D Ewald + analytic head/wing, RI on the 14x14x1 mesh
task = g0w0_band
input_dir = ../scf/OUT.librpa
input_preset = abacus
output_dir = librpa.d
output_level = info

# ---- reader v1 ----
version_coul_reader = 1
version_lri_reader = 1
prefix_coul_full = v1_coulomb_full_iq_
prefix_coul_cut = v1_coulomb_cut_iq_
prefix_lri_coeff = v1_Cs_data_
prefix_lri_coeff_shrink = v1_Cs_shrinked_data_
prefix_shrink_sinvS = v1_shrink_sinvS_
prefix_eigvecs_scf = KS_eigenvector
fn_stru = stru_out
fn_bz_sampling = bz_sampling_out
fn_basis_wfc = basis_wfc_out
fn_basis_aux = basis_aux_out
fn_basis_aux_shrink = basis_aux_shrink_out
fn_eigocc_scf = band_out
# fn_vxc_scf is concatenated onto input_dir, so it must be relative to that.
fn_vxc_scf = ../../scf/OUT.ABACUS/vxc_out.dat

# ---- 2D 介电与 head/wing：三个开关缺一不可 ----
option_dielect_func = 3
replace_w_head = t
use_2d_dielectric = t
use_fullcoul_eps = t
use_fullcoul_wc = t
use_fullcoul_exx = t

# ---- 对称性与 native head/wing velocity ----
# master_ghj >= 9ffe1aee retires g0w0_headwing_velocity / use_pyatb in favour of
# option_velocity. native differentiates the H(R), S(R) and r(R) blocks that
# ABACUS wrote in the same execution, so no external PyATB bundle is needed and
# an IBZ SCF grid is fine: LibRPA expands the 24 irreducible k points to the full
# 14x14 mesh itself (no eigenproblem solved) before differentiating.
option_velocity = native
# Relative names resolve against input_dir, so point them at OUT.ABACUS.
g0w0_fn_hr = ../../scf/OUT.ABACUS/hrs1_nao.csr
g0w0_fn_sr = ../../scf/OUT.ABACUS/sr_nao.csr
g0w0_fn_rr = ../../scf/OUT.ABACUS/rr.csr
g0w0_hr_unit = Ry
g0w0_rr_unit = Bohr

use_symmetry_exx = t
use_symmetry_gw = t
use_symmetry_rpa = t
use_kpara_scf_eigvec = t

# ---- 频率与求解 ----
nfreq = 16
tfgrids_type = minimax
n_params_anacon = 12
parallel_routing = libri
use_scalapack_gw_wc = t
use_cholesky_gw_wc = t
use_elpa_sqrt_coulomb = t

# ---- 态窗口：13 占据带里取顶 4 + 底 4 空 ----
i_state_low = 9
i_state_high = 17

# ---- 阈值 ----
vq_threshold = 0
sqrt_coulomb_threshold = 0
cs_threshold = 0
libri_chi0_threshold_C = 1e-4
libri_chi0_threshold_G = 1e-5
libri_g0w0_threshold_C = 1e-5
libri_g0w0_threshold_G = 1e-5
libri_g0w0_threshold_Wc = 1e-6

# ---- 辅助基 ----
use_shrink_abfs = t
use_shrink_chi = t

# ---- Wc 导出给 LibBSE ----
output_energy_qp = t
output_wc_rf = t
ifreq_output_wc_end = 1
